     "keys": []
    },
    {
     "text": "tend to neglect the personal experiences,",
     "from": 25.3,
     "to": 27.789,
     "keys": [
      {
       "text": "neglect",
       "t": 25.3
      },
      {
       "text": "personal experiences,",
       "t": 26.322
      }
     ]
    },
    {
     "text": "or the “situated standpoint”, of certain people",
     "from": 27.789,
     "to": 30.363,
     "keys": [
      {
       "text": "“situated standpoint”,",
       "t": 27.789
      }
     ]
    },
    {
     "text": "in their relationship with them.",
     "from": 30.363,
     "to": 32.329,
     "keys": []
    }
   ]
  },
  {
