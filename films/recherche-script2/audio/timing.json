   },
   "subs": [
    {
     "text": "For Magali Sarfatti Larson, in 1977,",
     "from": 90,
     "to": 93.431,
     "keys": [
      {
       "text": "Magali Sarfatti Larson,",
       "t": 90.17
      }
     ]
    },
    {
     "text": "a profession pursues a “professional project”:",
