     "from": 13.231,
     "to": 15.175,
     "keys": [
      {
       "text": "work?",
       "t": 13.231
      }
     ]
    },
    {
     "text": "Why is it hard for some people",
     "from": 15.175,
     "to": 16.725,
     "keys": []
    },
    {
     "text": "to enter a prestigious profession?",
     "from": 16.725,
     "to": 18.993,
     "keys": [
      {
       "text": "prestigious",
       "t": 17.23
      }
     ]
    }
   ]
  },
  {
