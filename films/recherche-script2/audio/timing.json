     "to": 105.633,
     "keys": [
      {
       "text": "social closure,",
       "t": 101.698
      },
      {
       "text": "Max Weber.",
       "t": 103.196
      }
     ]
    },
    {
     "text": "Fewer practitioners means more prestige",
     "from": 105.633,
     "to": 107.914,
     "keys": [
      {
       "text": "Fewer practitioners",
       "t": 105.633
      },
      {
       "text": "more prestige",
       "t": 106.731
      }
     ]
    },
    {
     "text": "and a monopoly over services.",
