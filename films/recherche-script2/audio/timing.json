    "ord": 53.465
   },
   "subs": [
    {
     "text": "For Talcott Parsons, in 1939,",
     "from": 34,
     "to": 36.753,
     "keys": [
      {
       "text": "Talcott Parsons,",
       "t": 34.175
      }
     ]
    },
    {
     "text": "professions fulfil a function essential to society:",
     "from": 36.753,
     "to": 39.841,
     "keys": [
      {
       "text": "essential",
       "t": 36.753
      }
     ]
    },
    {
     "text": "healing, defending, teaching.",
     "from": 39.841,
     "to": 42.507,
     "keys": [
      {
       "text": "healing,",
       "t": 39.841
      },
      {
       "text": "defending,",
       "t": 40.522
      },
      {
       "text": "teaching.",
       "t": 41.245
      }
     ]
    },
    {
     "text": "They are recognized by precise attributes:",
     "from": 42.507,
     "to": 44.441,
     "keys": []
    },
    {
     "text": "specialized knowledge, long training,",
     "from": 44.441,
     "to": 46.984,
     "keys": [
      {
       "text": "specialized knowledge,",
       "t": 44.441
      },
      {
       "text": "long training,",
       "t": 45.791
      }
     ]
    },
    {
     "text": "a code of ethics and a licence to practise.",
     "from": 46.984,
     "to": 50.094,
     "keys": [
      {
       "text": "code of ethics",
       "t": 46.984
      },
      {
       "text": "licence",
       "t": 48.185
      }
     ]
    },
    {
     "text": "In Canada, the provinces and territories regulate them,",
     "from": 50.094,
     "to": 53.465,
     "keys": [
      {
       "text": "provinces and territories",
       "t": 50.834
      }
     ]
    },
    {
     "text": "often through professional orders.",
     "from": 53.465,
     "to": 56.102,
     "keys": [
      {
       "text": "professional orders.",
       "t": 53.465
      }
     ]
    }
   ]
  },
