    "b": 13.231,
    "c": 15.175,
    "d": 16.725,
    "pres": 17.23
   },
   "subs": [
    {
     "text": "From a sociological point of view,",
     "from": 11.5,
     "to": 13.231,
     "keys": [
      {
       "text": "sociological",
       "t": 11.515
      }
     ]
    },
    {
