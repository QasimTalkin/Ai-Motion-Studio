     "from": 95.896,
     "to": 98.542,
     "keys": [
      {
       "text": "controlling its market",
       "t": 95.896
      },
      {
       "text": "raising its status.",
       "t": 96.873
      }
     ]
    },
    {
     "text": "Required degrees, exams, limited places:",
     "from": 98.542,
