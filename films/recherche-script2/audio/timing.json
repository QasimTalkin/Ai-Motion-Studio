       "text": "Required degrees,",
       "t": 98.542
      },
      {
       "text": "exams,",
       "t": 99.819
      },
      {
       "text": "limited places:",
       "t": 100.538
      }
     ]
    },
    {
     "text": "this is social closure, a concept inherited from Max Weber.",
